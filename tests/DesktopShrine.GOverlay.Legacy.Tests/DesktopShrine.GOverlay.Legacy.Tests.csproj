<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>../../assets/DesktopShrine.ico</ApplicationIcon>
    <DeployGOverlayPlugin>false</DeployGOverlayPlugin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="../../samples/DesktopShrine.Plugin.GOverlay/LegacySdk/DesktopShrine.Plugin.GOverlay.LegacySdk.csproj" AdditionalProperties="DeployGOverlayPlugin=false;Configuration=$(Configuration)" />
    <Reference Include="Interfaces">
      <HintPath>$(MSBuildProgramFiles32)\GOverlay\Interfaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
